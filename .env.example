# Copy to .env or export before launching the MCP server.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Required when you access client accounts through a manager (MCC).
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional path to google-ads.yaml instead of the fields above.
# GOOGLE_ADS_CONFIGURATION_FILE_PATH=/home/you/.google-ads-mcp/google-ads.yaml

# Writes are off until you flip this. New campaigns are still created PAUSED.
GOOGLE_ADS_WRITE_ENABLED=false
# If true, skip the confirm_token step (still requires WRITE_ENABLED).
GOOGLE_ADS_SKIP_CONFIRM=false
# Comma-separated allowlist. Empty means any accessible customer.
# GOOGLE_ADS_ALLOWED_CUSTOMER_IDS=1234567890
GOOGLE_ADS_BUDGET_INCREASE_CAP=0.20

# DuckDB 2.0 (alpha) local store for audit + dashboard snapshots.
# GOOGLE_ADS_MCP_DB=/home/you/.google-ads-mcp/state.duckdb
