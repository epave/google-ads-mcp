# Google Ads API credentials for the MCP server.
# Copy to .env and fill in real values. Never commit .env.
#
# How to obtain these:
#   1. Apply for a developer token in your Google Ads manager account:
#      https://developers.google.com/google-ads/api/docs/first-call/dev-token
#   2. Create an OAuth2 client (Desktop app) in Google Cloud Console and use it
#      to generate a refresh token:
#      https://developers.google.com/google-ads/api/docs/oauth/cloud-project

GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Optional: required when accessing accounts through a manager (MCC) account.
# 10-digit id, dashes are allowed (e.g. 123-456-7890).
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
